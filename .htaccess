# Superseating — Apache config (ignore if hosting elsewhere)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Old WordPress URLs -> new pages (keeps links and search rankings)
RewriteRule ^training-education/?$ /training-education.html [R=301,L]
RewriteRule ^clinical-and-regulatory-support(-2)?/?$ /clinical-regulatory-support.html [R=301,L]
RewriteRule ^r-and-d-design/?$ /rd-design.html [R=301,L]
RewriteRule ^account-and-distribution-support/?$ /account-distribution-support.html [R=301,L]
RewriteRule ^references/?$ /about.html#reference [R=301,L,NE]
RewriteRule ^news-events/?$ /news.html [R=301,L]
RewriteRule ^20[0-9]{2}/.*$ /news.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^privacy-beleid/?$ /privacy.html [R=301,L]
RewriteRule ^cookies-disclaimer/?$ /cookies.html [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>
